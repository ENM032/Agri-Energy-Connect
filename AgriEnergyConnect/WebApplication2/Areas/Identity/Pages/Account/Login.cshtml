@page
@model LoginModel

@{
    ViewData["Title"] = "Sign In";
}

<div class="auth-card">
    <div class="auth-header">
        <div class="auth-logo">
            <i class="bi bi-leaf"></i>
        </div>
        <h1 class="auth-title">Welcome Back</h1>
        <p class="auth-subtitle">Sign in to your AgriEnergyConnect account</p>
    </div>
    
    <div class="auth-body-content">
            <form id="account" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                
                <div class="form-group">
                    <label asp-for="Input.Email" class="form-label">
                        <i class="bi bi-envelope"></i> Email Address
                    </label>
                    <input asp-for="Input.Email" class="form-control auth-input" autocomplete="username" aria-required="true" placeholder="Enter your email" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                
                <div class="form-group">
                    <label asp-for="Input.Password" class="form-label">
                        <i class="bi bi-lock"></i> Password
                    </label>
                    <div class="password-input-container">
                        <input asp-for="Input.Password" class="form-control auth-input" autocomplete="current-password" aria-required="true" placeholder="Enter your password" type="password" id="passwordInput" />
                        <button type="button" class="password-toggle" onclick="togglePassword()">
                            <i class="bi bi-eye" id="passwordToggleIcon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                
                <div class="form-group remember-me">
                    <label class="custom-checkbox">
                        <input asp-for="Input.RememberMe" type="checkbox" />
                        <span class="checkmark"></span>
                        Remember me for 30 days
                    </label>
                </div>
                
                <button id="login-submit" type="submit" class="btn auth-btn">
                    <i class="bi bi-box-arrow-in-right"></i> Sign In
                </button>
                
                <div class="auth-divider">
                    <span>or</span>
                </div>
                
                <div class="auth-links">
                    <p class="signup-link">
                        Don't have an account?
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="auth-link">
                            Create Account
                        </a>
                    </p>
                    <a asp-page="./ForgotPassword" class="forgot-password-link">
                        Forgot your password?
                    </a>
                </div>
            </form>
        </div>
    </div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js" integrity="sha512-rstIgDs0xPgmG6RX1Aba4KV5cWJbAMcvRCVmglpam9SoHZiUCyQVDdH2LPlxoHtrv17XWblE/V/PP+Tr04hbtA==" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js" integrity="sha512-xq+Vm8jC94ynOikewaQXMEkJIOBp7iArs3IhFWSWdRT3Pq8wFz46p+ZDFAR7kHnSFf+zUv52B3prRYnbDRdgog==" crossorigin="anonymous"></script>
    <script src="~/js/auth.js"></script>
}
