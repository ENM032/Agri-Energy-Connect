@* Enhanced Login Page with Modern UI *@

@page
@model LoginModel

@{
    ViewData["Title"] = "Welcome Back";
    Layout = "_Layout";
}

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-logo">
                <i class="fas fa-leaf"></i>
            </div>
            <h1 class="auth-title">Welcome Back</h1>
            <p class="auth-subtitle">Sign in to your AgriEnergyConnect account</p>
        </div>
        
        <div class="auth-body">
            <form id="account" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                
                <div class="form-group">
                    <label asp-for="Input.Email" class="form-label">
                        <i class="fas fa-envelope"></i> Email Address
                    </label>
                    <input asp-for="Input.Email" class="form-control auth-input" autocomplete="username" aria-required="true" placeholder="Enter your email" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                
                <div class="form-group">
                    <label asp-for="Input.Password" class="form-label">
                        <i class="fas fa-lock"></i> Password
                    </label>
                    <div class="password-input-container">
                        <input asp-for="Input.Password" class="form-control auth-input" autocomplete="current-password" aria-required="true" placeholder="Enter your password" type="password" id="passwordInput" />
                        <button type="button" class="password-toggle" onclick="togglePassword()">
                            <i class="fas fa-eye" id="passwordToggleIcon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                
                <div class="form-group remember-me">
                    <label class="custom-checkbox">
                        <input asp-for="Input.RememberMe" type="checkbox" />
                        <span class="checkmark"></span>
                        Remember me for 30 days
                    </label>
                </div>
                
                <button id="login-submit" type="submit" class="btn auth-btn">
                    <i class="fas fa-sign-in-alt"></i> Sign In
                </button>
                
                <div class="auth-divider">
                    <span>or</span>
                </div>
                
                <div class="auth-links">
                    <p class="signup-link">
                        Don't have an account?
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="auth-link">
                            Create Account
                        </a>
                    </p>
                    <a asp-page="./ForgotPassword" class="forgot-password-link">
                        Forgot your password?
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/auth.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
}
