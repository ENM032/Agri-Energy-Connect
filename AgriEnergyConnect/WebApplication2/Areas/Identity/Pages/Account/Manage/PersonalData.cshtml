@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="container-fluid fade-in">
    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex align-items-center mb-3">
                <i class="fas fa-shield-alt text-primary me-3" style="font-size: 2rem;"></i>
                <div>
                    <h2 class="mb-1">@ViewData["Title"]</h2>
                    <p class="text-muted mb-0">Manage your personal data and privacy settings</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Navigation Sidebar -->
        <div class="col-md-3 mb-4">
            <partial name="_ManageNav" />
        </div>

        <!-- Main Content -->
        <div class="col-md-9">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-database me-2"></i>
                        Data Management
                    </h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-info" role="alert">
                        <i class="fas fa-info-circle me-2"></i>
                        Your account contains personal data that you have given us. This page allows you to download or delete that data.
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="card border-success mb-3">
                                <div class="card-header bg-success text-white">
                                    <i class="fas fa-download me-2"></i>
                                    Download Data
                                </div>
                                <div class="card-body">
                                    <p class="card-text">Download a copy of all your personal data in a portable format.</p>
                                    <form id="download-data" asp-page="DownloadPersonalData" method="post">
                                        <button class="btn btn-success" type="submit">
                                            <i class="fas fa-download me-2"></i>
                                            Download My Data
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card border-danger mb-3">
                                <div class="card-header bg-danger text-white">
                                    <i class="fas fa-trash-alt me-2"></i>
                                    Delete Account
                                </div>
                                <div class="card-body">
                                    <p class="card-text text-danger">
                                        <strong>Warning:</strong> Deleting this data will permanently remove your account, and this cannot be recovered.
                                    </p>
                                    <a id="delete" asp-page="DeletePersonalData" class="btn btn-danger">
                                        <i class="fas fa-trash-alt me-2"></i>
                                        Delete Account
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Privacy Information -->
            <div class="card shadow-sm mt-4">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-user-shield me-2"></i>
                        Privacy Information
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4 text-center mb-3">
                            <i class="fas fa-lock text-primary" style="font-size: 2rem;"></i>
                            <h6 class="mt-2">Secure Storage</h6>
                            <p class="text-muted small">Your data is encrypted and stored securely</p>
                        </div>
                        <div class="col-md-4 text-center mb-3">
                            <i class="fas fa-eye-slash text-primary" style="font-size: 2rem;"></i>
                            <h6 class="mt-2">Privacy First</h6>
                            <p class="text-muted small">We never share your personal information</p>
                        </div>
                        <div class="col-md-4 text-center mb-3">
                            <i class="fas fa-user-check text-primary" style="font-size: 2rem;"></i>
                            <h6 class="mt-2">Your Control</h6>
                            <p class="text-muted small">You have full control over your data</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
