{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.RollingFile"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/agri-energy-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "shared": true,
          "flushToDiskInterval": "00:00:01",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/errors/agri-energy-errors-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 90,
          "fileSizeLimitBytes": 52428800,
          "rollOnFileSizeLimit": true,
          "shared": true,
          "restrictedToMinimumLevel": "Warning",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/performance/agri-energy-performance-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "shared": true,
          "restrictedToMinimumLevel": "Information",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithEnvironmentUserName"
    ],
    "Properties": {
      "Application": "AgriEnergyConnect",
      "Environment": "Development"
    }
  },
  "LogRetentionPolicy": {
    "GeneralLogs": {
      "RetentionDays": 30,
      "MaxFileSizeMB": 10,
      "MaxTotalSizeGB": 1
    },
    "ErrorLogs": {
      "RetentionDays": 90,
      "MaxFileSizeMB": 50,
      "MaxTotalSizeGB": 5
    },
    "PerformanceLogs": {
      "RetentionDays": 7,
      "MaxFileSizeMB": 10,
      "MaxTotalSizeGB": 0.5
    },
    "CleanupSchedule": {
      "Enabled": true,
      "IntervalHours": 24,
      "StartTime": "02:00:00"
    }
  },
  "LoggingConfiguration": {
    "EnableRequestLogging": true,
    "EnablePerformanceLogging": true,
    "EnableSecurityLogging": true,
    "LogSlowRequests": true,
    "SlowRequestThresholdMs": 5000,
    "ExcludedPaths": [
      "/health",
      "/health/ready",
      "/health/live",
      "/favicon.ico",
      "/css",
      "/js",
      "/images"
    ],
    "SensitiveDataMasking": {
      "Enabled": true,
      "MaskPatterns": [
        "password",
        "token",
        "secret",
        "key",
        "authorization"
      ]
    }
  }
}