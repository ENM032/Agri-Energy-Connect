@{
    ViewData["Title"] = "Admin Dashboard";
    var dashboardData = ViewBag.DashboardData;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h1 class="display-4 text-primary mb-4">
                <i class="bi bi-speedometer2"></i> Admin Dashboard
            </h1>
            <p class="lead text-muted">Welcome to the AgriEnergy Connect administration panel</p>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card bg-primary text-white h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="card-title">@dashboardData.TotalUsers</h4>
                            <p class="card-text">Total Users</p>
                        </div>
                        <div class="align-self-center">
                            <i class="bi bi-people-fill fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-3 mb-3">
            <div class="card bg-success text-white h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="card-title">@dashboardData.FarmersCount</h4>
                            <p class="card-text">Farmers</p>
                        </div>
                        <div class="align-self-center">
                            <i class="bi bi-person-workspace fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-3 mb-3">
            <div class="card bg-info text-white h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="card-title">@dashboardData.SupportEmployeesCount</h4>
                            <p class="card-text">Support Staff</p>
                        </div>
                        <div class="align-self-center">
                            <i class="bi bi-headset fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-3 mb-3">
            <div class="card bg-warning text-white h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="card-title">@dashboardData.TotalProducts</h4>
                            <p class="card-text">Total Products</p>
                        </div>
                        <div class="align-self-center">
                            <i class="bi bi-box-seam fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-lightning-charge"></i> Quick Actions
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <a href="@Url.Action("Create", "Employees")" class="btn btn-primary btn-lg w-100">
                                <i class="bi bi-person-plus-fill"></i><br>
                                Create Support Employee
                            </a>
                        </div>
                        <div class="col-md-4 mb-3">
                            <a href="@Url.Action("ManageUsers", "Admin")" class="btn btn-success btn-lg w-100">
                                <i class="bi bi-people"></i><br>
                                Manage Users
                            </a>
                        </div>
                        <div class="col-md-4 mb-3">
                            <a href="@Url.Action("ManageProducts", "Admin")" class="btn btn-info btn-lg w-100">
                                <i class="bi bi-box-seam"></i><br>
                                Manage Products
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- System Information -->
    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-info-circle"></i> System Information
                    </h5>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled">
                        <li><strong>Platform:</strong> AgriEnergy Connect</li>
                        <li><strong>Version:</strong> 2.0</li>
                        <li><strong>Environment:</strong> Development</li>
                        <li><strong>Last Updated:</strong> @DateTime.Now.ToString("yyyy-MM-dd")</li>
                    </ul>
                </div>
            </div>
        </div>
        
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-shield-check"></i> Role Distribution
                    </h5>
                </div>
                <div class="card-body">
                    <div class="mb-2">
                        <div class="d-flex justify-content-between">
                            <span>Admins</span>
                            <span class="badge bg-danger">@dashboardData.AdminsCount</span>
                        </div>
                    </div>
                    <div class="mb-2">
                        <div class="d-flex justify-content-between">
                            <span>Support Employees</span>
                            <span class="badge bg-info">@dashboardData.SupportEmployeesCount</span>
                        </div>
                    </div>
                    <div class="mb-2">
                        <div class="d-flex justify-content-between">
                            <span>Farmers</span>
                            <span class="badge bg-success">@dashboardData.FarmersCount</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>