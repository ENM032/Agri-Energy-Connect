@model WebApplication2.Models.ViewModels.UserProfileViewModel
@{
    ViewData["Title"] = "Delete User";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h3 class="mb-0">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        Confirm User Deletion
                    </h3>
                </div>
                <div class="card-body">
                    <div class="alert alert-danger" role="alert">
                        <strong>Warning:</strong> This action cannot be undone. Deleting this user will permanently remove their account and all associated data.
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-3"><strong>Display Name:</strong></div>
                        <div class="col-sm-9">@Model.DisplayName</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-3"><strong>Email:</strong></div>
                        <div class="col-sm-9">@Model.Email</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-3"><strong>User ID:</strong></div>
                        <div class="col-sm-9"><code>@Model.Id</code></div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-3"><strong>Roles:</strong></div>
                        <div class="col-sm-9">
                            @if (Model.Roles != null && Model.Roles.Any())
                            {
                                @foreach (string role in Model.Roles)
                                {
                                    <span class="badge bg-primary me-1">@role</span>
                                }
                            }
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-3"><strong>Registration Date:</strong></div>
                        <div class="col-sm-9">@Model.FormattedCreatedDate</div>
                    </div>

                    @if (Model.Roles != null && Model.Roles.Contains("Farmer"))
                    {
                        <div class="alert alert-warning mt-3" role="alert">
                            <i class="fas fa-info-circle me-2"></i>
                            <strong>Note:</strong> This user is a Farmer. Deleting this account will also permanently remove all products associated with this farmer.
                        </div>
                    }

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="ManageUsers" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-2"></i>
                            Cancel
                        </a>
                        
                        <form asp-action="DeleteUser" method="post" class="d-inline">
                            <input type="hidden" asp-for="Id" />
                            <button type="submit" class="btn btn-danger" 
                                    onclick="return confirm('Are you absolutely sure you want to delete this user? This action cannot be undone.')">
                                <i class="fas fa-trash me-2"></i>
                                Delete User
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Additional confirmation for critical action
        document.querySelector('form[asp-action="DeleteUser"]').addEventListener('submit', function(e) {
            if (!confirm('FINAL CONFIRMATION: Delete user "@Model.DisplayName"? This action is irreversible.')) {
                e.preventDefault();
            }
        });
    </script>
}