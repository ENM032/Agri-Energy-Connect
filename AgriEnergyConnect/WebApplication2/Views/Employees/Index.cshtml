@model IEnumerable<WebApplication2.Areas.Identity.Data.WebApplication2User>
@{
    ViewData["Title"] = "Farmer Management";
}

<div class="fade-in">
    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="h3 mb-0">
                <i class="bi bi-people me-2 text-primary"></i>Farmer Management
            </h1>
            <p class="text-muted mb-0">Manage registered farmers on the platform</p>
        </div>
        <div class="col-md-4 text-md-end">
            <a asp-action="Create" class="btn btn-primary btn-lg">
                <i class="bi bi-person-plus me-2"></i>Add New Farmer
            </a>
        </div>
    </div>

    <!-- TempData Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="bi bi-info-circle me-2"></i>@TempData["InfoMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    @if (Model != null && Model.Any())
    {
        <!-- Statistics Cards -->
        <div class="row mb-4">
            <div class="col-md-4">
                <div class="card border-0 bg-primary text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h5 class="card-title mb-0">Total Farmers</h5>
                                <h2 class="mb-0">@Model.Count()</h2>
                            </div>
                            <i class="bi bi-people display-4 opacity-75"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 bg-success text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h5 class="card-title mb-0">Active Users</h5>
                                <h2 class="mb-0">@Model.Count()</h2>
                            </div>
                            <i class="bi bi-person-check display-4 opacity-75"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 bg-info text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h5 class="card-title mb-0">Quick Actions</h5>
                                <p class="mb-0">Manage farmers</p>
                            </div>
                            <i class="bi bi-gear display-4 opacity-75"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Farmers Grid -->
        <div class="row mb-4">
            @foreach (var item in Model)
            {
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="card h-100 border-0 shadow-sm hover-lift">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-primary rounded-circle p-3 me-3">
                                    <i class="bi bi-person-fill text-white"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <h5 class="card-title mb-1">@item.Displayname</h5>
                                    <p class="text-muted mb-0 small">Farmer</p>
                                </div>
                            </div>
                            <div class="mb-3">
                                <p class="mb-1">
                                    <i class="bi bi-envelope me-2 text-muted"></i>
                                    <span class="small">@item.Email</span>
                                </p>
                                <p class="mb-0">
                                    <i class="bi bi-hash me-2 text-muted"></i>
                                    <span class="small text-muted">ID: @item.Id.Substring(0, 8)...</span>
                                </p>
                            </div>
                            <div class="d-flex gap-2">
                                <a asp-controller="Employees" asp-action="FarmerProducts" asp-route-userId="@item.Id" class="btn btn-outline-primary btn-sm flex-fill">
                                    <i class="bi bi-box-seam me-1"></i>Products
                                </a>
                                <a asp-action="DeleteFarmer" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm" 
                                   onclick="return confirm('Are you sure you want to delete this farmer? This action cannot be undone.')">
                                    <i class="bi bi-trash me-1"></i>Delete
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Farmers Table -->
        <div class="card border-0">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-table me-2"></i>Farmers Table View
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="border-0">
                                    <i class="bi bi-hash me-1"></i>ID
                                </th>
                                <th class="border-0">
                                    <i class="bi bi-envelope me-1"></i>@Html.DisplayNameFor(model => model.Email)
                                </th>
                                <th class="border-0">
                                    <i class="bi bi-person me-1"></i>@Html.DisplayNameFor(model => model.Displayname)
                                </th>
                                <th class="border-0 text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="align-middle">
                                        <code class="small">@item.Id.Substring(0, 8)...</code>
                                    </td>
                                    <td class="align-middle">
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-envelope me-2 text-muted"></i>
                                            @Html.DisplayFor(modelItem => item.Email)
                                        </div>
                                    </td>
                                    <td class="align-middle">
                                        <div class="d-flex align-items-center">
                                            <div class="bg-primary rounded-circle p-1 me-2">
                                                <i class="bi bi-person-fill text-white small"></i>
                                            </div>
                                            <strong>@Html.DisplayFor(modelItem => item.Displayname)</strong>
                                        </div>
                                    </td>
                                    <td class="align-middle text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-controller="Employees" asp-action="FarmerProducts" asp-route-userId="@item.Id" 
                                               class="btn btn-outline-primary btn-sm" title="View Products">
                                                <i class="bi bi-box-seam"></i>
                                            </a>
                                            <a asp-action="DeleteFarmer" asp-route-id="@item.Id" 
                                               class="btn btn-outline-danger btn-sm" title="Delete Farmer"
                                               onclick="return confirm('Are you sure you want to delete this farmer? This action cannot be undone.')">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="text-center py-5">
            <div class="card border-0">
                <div class="card-body py-5">
                    <i class="bi bi-people display-1 text-muted mb-3"></i>
                    <h3 class="text-muted mb-3">No Farmers Registered</h3>
                    <p class="text-muted mb-4">Start by adding the first farmer to the platform.</p>
                    <a asp-action="Create" class="btn btn-primary btn-lg">
                        <i class="bi bi-person-plus me-2"></i>Add First Farmer
                    </a>
                </div>
            </div>
        </div>
    }
</div>
