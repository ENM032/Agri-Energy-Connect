@model WebApplication2.Models.ViewModels.FarmerProductsViewModel

@{
    ViewData["Title"] = "Farmer Products";
}

<h1>Farmer Products</h1>
<h6 style="color:#6c757d">After applying filters, click on the filter button again to view a list of all products</h6>

<!-- TempData Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["InfoMessage"] != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        <i class="bi bi-info-circle me-2"></i>@TempData["InfoMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form asp-action="FarmerProducts" asp-controller="Employees" >
    <select name="selectedUser" asp-items="Model.UserNameList">
        <option value="">Select Farmer</option>
    </select>
    <select name="selectedCategory" asp-items="Model.CategoriesSelectList">
        <option value="">Select Category</option>
    </select>
    Start date:
    <input name="startDate" type="date" value="@Model.BetweenStartDate?.ToString("yyyy-MM-dd")" />
    End date:
    <input name="endDate" type="date" value="@Model.BetweenEndDate?.ToString("yyyy-MM-dd")" />
    <button type="submit" class="btn btn-formpurple">
        <i class="bi bi-search"></i>
        Filter
    </button>
</form>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<table class="table table-bordered table-responsive table-hover">
    <thead>
        <tr>
            <th>
                Product Name
            </th>
            <th>
                Category
            </th>
            <th>
                Date Created
            </th>
            <th>
                Farmer Username
            </th>
            <th>
                Farmer Display Name
            </th>
            <th>
                User ID
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Products)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Category)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ProductDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.UserName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.UserDisplayName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.UserId)
                </td>
                <td>
                    <a asp-action="DeleteFarmerProduct" asp-route-id="@item.Id" class="labelbtn">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Pagination Controls -->
@if (Model.TotalPages > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            @if (Model.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" href="?page=@(Model.CurrentPage - 1)&selectedUser=@Model.SelectedUser&selectedCategory=@Model.SelectedCategory&startDate=@Model.BetweenStartDate?.ToString("yyyy-MM-dd")&endDate=@Model.BetweenEndDate?.ToString("yyyy-MM-dd")">Previous</a>
                </li>
            }
            
            @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" href="?page=@i&selectedUser=@Model.SelectedUser&selectedCategory=@Model.SelectedCategory&startDate=@Model.BetweenStartDate?.ToString("yyyy-MM-dd")&endDate=@Model.BetweenEndDate?.ToString("yyyy-MM-dd")">@i</a>
                </li>
            }
            
            @if (Model.CurrentPage < Model.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link" href="?page=@(Model.CurrentPage + 1)&selectedUser=@Model.SelectedUser&selectedCategory=@Model.SelectedCategory&startDate=@Model.BetweenStartDate?.ToString("yyyy-MM-dd")&endDate=@Model.BetweenEndDate?.ToString("yyyy-MM-dd")">Next</a>
                </li>
            }
        </ul>
    </nav>
    
    <div class="text-center mt-3">
        <small class="text-muted">
            Showing @((Model.CurrentPage - 1) * Model.PageSize + 1) to @(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalProducts)) of @Model.TotalProducts products
        </small>
    </div>
}

@if (Model.TotalProducts == 0)
{
    <div class="alert alert-info text-center">
        <i class="bi bi-info-circle me-2"></i>
        No products found matching the selected criteria.
    </div>
}

