@model FarmerRegistrationModel
@{
    ViewData["Title"] = "Create Support Employee";
}

<div class="fade-in">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="mb-1"><i class="bi bi-person-plus me-2 text-primary"></i>Create Support Employee</h2>
                    <p class="text-muted mb-0">Add a new support employee to the AgriEnergy Connect platform</p>
                </div>
                <a asp-controller="Admin" asp-action="ManageUsers" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Back to Users
                </a>
            </div>
        </div>
    </div>

    <!-- Create Employee Form -->
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-person-badge me-2"></i>Employee Account Details</h5>
                </div>
                <div class="card-body p-4">
                    <form id="registerForm" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label fw-semibold">
                                    <i class="bi bi-envelope me-1 text-primary"></i>Email Address <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Email" class="form-control form-control-lg" placeholder="employee@example.com" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            
                            <div class="col-md-6 mb-3">
                                <label asp-for="DisplayName" class="form-label fw-semibold">
                                    <i class="bi bi-person me-1 text-primary"></i>Display Name
                                </label>
                                <input asp-for="DisplayName" class="form-control form-control-lg" placeholder="Employee Name" />
                                <span asp-validation-for="DisplayName" class="text-danger small"></span>
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Password" class="form-label fw-semibold">
                                    <i class="bi bi-lock me-1 text-primary"></i>Password <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Password" class="form-control form-control-lg" placeholder="Enter secure password" type="password" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                            
                            <div class="col-md-6 mb-3">
                                <label asp-for="ConfirmPassword" class="form-label fw-semibold">
                                    <i class="bi bi-lock me-1 text-primary"></i>Confirm Password <span class="text-danger">*</span>
                                </label>
                                <input asp-for="ConfirmPassword" class="form-control form-control-lg" placeholder="Confirm password" type="password" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>
                        @* 
                        This code was taken from a Youtube video
                        Uploaded by: Macro Code
                        Titled: ASP.NET Core 7.0 Role Based Authorization || How to Implement Roles Based Authorization
                        Available at: https://www.youtube.com/watch?v=VZgxKbAdbbo
                        Accessed 24 May 2023 
                        *@
                        <div class="mb-3">
                            <label asp-for="Role" class="form-label fw-semibold">
                                <i class="bi bi-shield me-1 text-primary"></i>Role Assignment <span class="text-danger">*</span>
                            </label>
                            <select asp-for="Role" class="form-select form-select-lg" aria-required="true">
                                <option value="Support Employee" selected>Support Employee</option>
                            </select>
                            <span asp-validation-for="Role" class="text-danger small"></span>
                            <div class="form-text">
                                <small class="text-muted">
                                    <i class="bi bi-info-circle me-1"></i>
                                    This account will be created with Support Employee privileges
                                </small>
                            </div>
                        </div>
                        
                        <!-- Security Notice -->
                        <div class="alert alert-info border-0 mb-4">
                            <div class="d-flex align-items-start">
                                <i class="bi bi-shield-check text-info me-3 mt-1"></i>
                                <div>
                                    <h6 class="alert-heading mb-1">Employee Access</h6>
                                    <p class="mb-0 small">
                                        Support employees can view farmer profiles, manage farmer products, and assist with platform support.
                                    </p>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Action Buttons -->
                        <div class="d-flex justify-content-between">
                            <a asp-controller="Admin" asp-action="ManageUsers" class="btn btn-light btn-lg px-4">
                                <i class="bi bi-times me-1"></i>Cancel
                            </a>
                            <button id="registerSubmit" type="submit" class="btn btn-primary btn-lg px-4">
                                <i class="bi bi-person-plus me-1"></i>Create Support Employee
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

