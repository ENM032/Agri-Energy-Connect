<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Agri-Energy Connect</title>
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebApplication2.styles.css" asp-append-version="true" />
</head>
<body class="auth-body">
    <div class="auth-layout-container">
        <!-- Header with branding -->
        <header class="auth-header-bar">
            <div class="container-fluid">
                <div class="row align-items-center py-3">
                    <div class="col-auto">
                        <a href="/" class="d-flex align-items-center text-decoration-none">
                            <i class="bi bi-leaf fs-2 text-primary me-2"></i>
                            <span class="fs-4 fw-bold text-dark">Agri-Energy Connect</span>
                        </a>
                    </div>
                    <div class="col text-end">
                        <a href="/" class="btn btn-outline-primary">
                            <i class="bi bi-house me-1"></i> Back to Home
                        </a>
                    </div>
                </div>
            </div>
        </header>

        <!-- Main content area -->
        <main class="auth-main-content">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-12 col-md-8 col-lg-6 col-xl-5">
                        @RenderBody()
                    </div>
                </div>
            </div>
        </main>

        <!-- Footer -->
        <footer class="auth-footer">
            <div class="container">
                <div class="row">
                    <div class="col text-center">
                        <p class="mb-0 text-muted">
                            &copy; @DateTime.Now.Year Agri-Energy Connect. Connecting farmers with sustainable energy solutions.
                        </p>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>