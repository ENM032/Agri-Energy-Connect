@using Microsoft.AspNetCore.Identity
@using WebApplication2.Areas.Identity.Data

@inject SignInManager<WebApplication2User> SignInManager
@inject UserManager<WebApplication2User> UserManager

@if (SignInManager.IsSignedIn(User))
{
        var user = UserManager.GetUserAsync(User).Result;
        var displayname = user.Displayname;

    @if (displayname == null || displayname == "")
    {
        <li>
            <a id="manage" class="dropdown-item d-flex align-items-center py-2" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">
                <i class="bi bi-person-gear me-2"></i>@user.Email
            </a>
        </li>
    }
    else
    {
        <li>
            <a id="manage" class="dropdown-item d-flex align-items-center py-2" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">
                <i class="bi bi-person-gear me-2"></i>@displayname
            </a>
        </li>
    }
    <li><hr class="dropdown-divider"></li>
    <li>
        <form id="logoutForm" class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button id="logout" type="submit" class="dropdown-item d-flex align-items-center py-2 border-0 bg-transparent text-white w-100">
                <i class="bi bi-box-arrow-right me-2"></i>Logout
            </button>
        </form>
    </li>
}
else
{
    <li>
        <a class="dropdown-item d-flex align-items-center py-2" id="register" asp-area="Identity" asp-page="/Account/Register">
            <i class="bi bi-person-plus me-2"></i>Register
        </a>
    </li>
    <li>
        <a class="dropdown-item d-flex align-items-center py-2" id="login" asp-area="Identity" asp-page="/Account/Login">
            <i class="bi bi-box-arrow-in-right me-2"></i>Login
        </a>
    </li>
}
