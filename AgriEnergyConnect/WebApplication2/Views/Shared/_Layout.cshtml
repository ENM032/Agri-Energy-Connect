<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Agri-Energy Connect</title>
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    
    <!-- Preload critical resources -->
    <link rel="preload" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"></noscript>
    
    <link rel="preload" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"></noscript>
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebApplication2.styles.css" asp-append-version="true" />
    
    <!-- DNS prefetch for external resources -->
    <link rel="dns-prefetch" href="//cdn.jsdelivr.net">
</head>
<body>
    <div class="container-fluid">
        <div class="row flex-nowrap">
            <!-- Sidebar Navigation -->
            <div class="col-auto col-md-3 col-xl-2 px-sm-2 px-0 sidebar-dark">
                <div class="d-flex flex-column align-items-center align-items-sm-start px-3 pt-3 text-white min-vh-100">
                    <!-- Brand -->
                    <a href="/" class="d-flex align-items-center pb-3 mb-md-1 me-md-auto text-white text-decoration-none">
                        <i class="bi bi-leaf fs-4 me-2"></i>
                        <span class="fs-5 d-none d-sm-inline fw-bold">Agri-Energy Connect</span>
                    </a>
                    
                    <!-- Navigation Menu -->
                    <ul class="nav nav-pills flex-column mb-sm-auto mb-0 align-items-center align-items-sm-start w-100" id="menu">
                        <li class="nav-item w-100">
                            <a asp-controller="Home" asp-action="Index" class="nav-link align-middle px-2 text-white rounded">
                                <i class="fs-5 bi bi-house-fill"></i><span class="ms-2 d-none d-sm-inline">Dashboard</span>
                            </a>
                        </li>

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="w-100">
                                <a href="#adminSubmenu" data-bs-toggle="collapse" class="nav-link px-2 align-middle text-white rounded">
                                    <i class="fs-5 bi bi-shield-fill"></i><span class="ms-2 d-none d-sm-inline">Administration</span>
                                    <i class="bi bi-chevron-down ms-auto d-none d-sm-inline"></i>
                                </a>
                                <ul class="collapse nav flex-column ms-3" id="adminSubmenu">
                                    <li class="w-100">
                                        <a asp-controller="Admin" asp-action="Index" class="nav-link px-2 text-white-50 rounded">
                                            <i class="bi bi-speedometer2 me-2"></i>Dashboard
                                        </a>
                                    </li>
                                    <li class="w-100">
                                        <a asp-controller="Admin" asp-action="ManageUsers" class="nav-link px-2 text-white-50 rounded">
                                            <i class="bi bi-people me-2"></i>Manage Users
                                        </a>
                                    </li>
                                    <li class="w-100">
                                        <a asp-controller="Admin" asp-action="ManageProducts" class="nav-link px-2 text-white-50 rounded">
                                            <i class="bi bi-box-seam me-2"></i>Manage Products
                                        </a>
                                    </li>
                                    <li class="w-100">
                                        <a asp-controller="Analytics" asp-action="Index" class="nav-link px-2 text-white-50 rounded">
                                            <i class="bi bi-graph-up me-2"></i>Analytics
                                        </a>
                                    </li>
                                    <li class="w-100">
                                        <a asp-controller="Admin" asp-action="CreateAdmin" class="nav-link px-2 text-white-50 rounded">
                                            <i class="bi bi-person-plus-fill me-2"></i>Create Admin
                                        </a>
                                    </li>
                                    <li class="w-100">
                                        <a asp-controller="Employees" asp-action="Create" class="nav-link px-2 text-white-50 rounded">
                                            <i class="bi bi-person-plus me-2"></i>Add Support Employee
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else if (User.IsInRole("Support Employee"))
                        {
                            <li class="w-100">
                                <a href="#supportSubmenu" data-bs-toggle="collapse" class="nav-link px-2 align-middle text-white rounded">
                                    <i class="fs-5 bi bi-headset"></i><span class="ms-2 d-none d-sm-inline">Support</span>
                                    <i class="bi bi-chevron-down ms-auto d-none d-sm-inline"></i>
                                </a>
                                <ul class="collapse nav flex-column ms-3" id="supportSubmenu">
                                    <li class="w-100">
                                        <a asp-controller="Products" asp-action="Index" class="nav-link px-2 text-white-50 rounded">
                                            <i class="bi bi-box-seam me-2"></i>All Products
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else if (User.IsInRole("Farmer"))
                        {
                            <li class="w-100">
                                <a href="#productSubmenu" data-bs-toggle="collapse" class="nav-link px-2 align-middle text-white rounded">
                                    <i class="fs-5 bi bi-box-seam-fill"></i><span class="ms-2 d-none d-sm-inline">My Products</span>
                                    <i class="bi bi-chevron-down ms-auto d-none d-sm-inline"></i>
                                </a>
                                <ul class="collapse nav flex-column ms-3" id="productSubmenu">
                                    <li class="w-100">
                                        <a asp-controller="Products" asp-action="Index" class="nav-link px-2 text-white-50 rounded">
                                            <i class="bi bi-list-ul me-2"></i>View All
                                        </a>
                                    </li>
                                    <li class="w-100">
                                        <a asp-controller="Products" asp-action="Create" class="nav-link px-2 text-white-50 rounded">
                                            <i class="bi bi-plus-circle me-2"></i>Add Product
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>
                    
                    <!-- User Account Section -->
                    <div class="dropdown pb-4 w-100">
                        <a href="#" class="d-flex align-items-center text-white text-decoration-none dropdown-toggle" id="dropdownUser1" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle fs-4 me-2"></i>
                            <span class="d-none d-sm-inline">Account</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-dark text-small shadow" aria-labelledby="dropdownUser1">
                            <partial name="_LoginPartial" />
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Main Content -->
            <div class="col py-3">
                <div class="container-fluid">
                    <main role="main">
                        @RenderBody()
                    </main>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
