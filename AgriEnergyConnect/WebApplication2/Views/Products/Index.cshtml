@model IEnumerable<WebApplication2.Models.Product>

@{
    ViewData["Title"] = "My Products";
}

<div class="fade-in">
    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="h3 mb-0">
                <i class="bi bi-box-seam me-2 text-primary"></i>My Products
            </h1>
            <p class="text-muted mb-0">Manage your agricultural product listings</p>
        </div>
        <div class="col-md-4 text-md-end">
            <a asp-action="Create" class="btn btn-primary btn-lg">
                <i class="bi bi-plus-circle me-2"></i>Add New Product
            </a>
        </div>
    </div>

    <!-- TempData Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="bi bi-info-circle me-2"></i>@TempData["InfoMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    @if (Model != null && Model.Any())
    {
        <!-- Filter Section -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light">
                <h6 class="mb-0">
                    <i class="bi bi-funnel me-2"></i>Filter Products
                </h6>
            </div>
            <div class="card-body">
                <form method="get" asp-action="Index">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label for="searchName" class="form-label">Product Name</label>
                            <input type="text" class="form-control" id="searchName" name="searchName" placeholder="Search by name..." value="@ViewBag.SearchName" />
                        </div>
                        <div class="col-md-3">
                            <label for="categoryFilter" class="form-label">Category</label>
                            <select class="form-select" id="categoryFilter" name="categoryFilter">
                                <option value="">All Categories</option>
                                <option value="Cereals" selected="@(ViewBag.CategoryFilter == "Cereals")">Cereals</option>
                                <option value="Seeds" selected="@(ViewBag.CategoryFilter == "Seeds")">Seeds</option>
                                <option value="Pulses" selected="@(ViewBag.CategoryFilter == "Pulses")">Pulses</option>
                                <option value="Fruits" selected="@(ViewBag.CategoryFilter == "Fruits")">Fruits</option>
                                <option value="Vegetables" selected="@(ViewBag.CategoryFilter == "Vegetables")">Vegetables</option>
                                <option value="Herbs & Spices" selected="@(ViewBag.CategoryFilter == "Herbs & Spices")">Herbs & Spices</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label for="dateFrom" class="form-label">Date From</label>
                            <input type="date" class="form-control" id="dateFrom" name="dateFrom" value="@ViewBag.DateFrom" />
                        </div>
                        <div class="col-md-2">
                            <label for="dateTo" class="form-label">Date To</label>
                            <input type="date" class="form-control" id="dateTo" name="dateTo" value="@ViewBag.DateTo" />
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary me-2">
                                <i class="bi bi-search me-1"></i>Filter
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-clockwise me-1"></i>Clear
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
        <!-- Products Grid -->
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="card h-100 border-0 shadow-sm hover-lift">
                        <div class="card-header bg-light border-0">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="badge bg-primary rounded-pill">@item.Category</span>
                                <small class="text-muted">
                                    <i class="bi bi-calendar3 me-1"></i>@item.ProductDate.ToString("MMM dd, yyyy")
                                </small>
                            </div>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title text-truncate" title="@item.Name">
                                <i class="bi bi-box me-2 text-success"></i>@item.Name
                            </h5>
                            <div class="mt-auto">
                                <div class="d-flex gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm flex-fill">
                                        <i class="bi bi-pencil me-1"></i>Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm flex-fill">
                                        <i class="bi bi-trash me-1"></i>Delete
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Products Table (Alternative View) -->
        <div class="card border-0 mt-4">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-table me-2"></i>Products Table View
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="border-0">
                                    <i class="bi bi-box me-1"></i>@Html.DisplayNameFor(model => model.Name)
                                </th>
                                <th class="border-0">
                                    <i class="bi bi-tag me-1"></i>@Html.DisplayNameFor(model => model.Category)
                                </th>
                                <th class="border-0">
                                    <i class="bi bi-calendar3 me-1"></i>@Html.DisplayNameFor(model => model.ProductDate)
                                </th>
                                <th class="border-0 text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="align-middle">
                                        <strong>@Html.DisplayFor(modelItem => item.Name)</strong>
                                    </td>
                                    <td class="align-middle">
                                        <span class="badge bg-primary rounded-pill">@Html.DisplayFor(modelItem => item.Category)</span>
                                    </td>
                                    <td class="align-middle">
                                        @item.ProductDate.ToString("MMM dd, yyyy")
                                    </td>
                                    <td class="align-middle text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="text-center py-5">
            <div class="card border-0">
                <div class="card-body py-5">
                    <i class="bi bi-box display-1 text-muted mb-3"></i>
                    <h3 class="text-muted mb-3">No Products Yet</h3>
                    <p class="text-muted mb-4">Start by adding your first agricultural product to the platform.</p>
                    <a asp-action="Create" class="btn btn-primary btn-lg">
                        <i class="bi bi-plus-circle me-2"></i>Add Your First Product
                    </a>
                </div>
            </div>
        </div>
    }
</div>
